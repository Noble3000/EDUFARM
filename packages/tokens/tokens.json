{
  "$schema": "https://edufarm.ng/tokens/v0",
  "version": "0.1.0",
  "source": "Docs/IMPLEMENTATION_PLAN.md §0.2 + Docs/DESIGN_SYSTEM_PREVIEW.html",
  "color": {
    "brand": { "primary": "#0E5A3C", "primaryDark": "#0A4230", "accent": "#C9A227" },
    "ink": { "900": "#101828", "700": "#344054", "500": "#667085", "300": "#D0D5DD", "100": "#F2F4F7" },
    "paper": { "default": "#FFFFFF", "alt": "#F9FAFB", "readerDark": "#1D2939" },
