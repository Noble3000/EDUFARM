// Prisma schema v1 — local PostgreSQL 16 (NOT Supabase).
// DB: edufarm (dev) / edufarm_test (CI). Extension: vector (Phase 3 RAG).
// Run: pnpm db:generate && pnpm db:migrate (after Postgres 16 installed locally).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  student
  lecturer
  deptAdmin
  institutionAdmin
  platformAdmin
}

enum VerificationStatus {
  unverified
  pending
  needsCorrection
  verified
  rejected
  suspended
}

enum EnrollmentStatus {
  requested
  approved
  rejected
  removed
  suspended
}

enum MaterialStatus {
  draft
  pendingLecturer
  pendingReview
  published
  archived
}

enum QuestionStatus {
  unanswered
  answered
  resolved
}

enum PurchaseStatus {
  pending
  completed
  failed
  refunded
  revoked
  suspended
}

enum LedgerStatus {
  pending
  available
  settled
}

// Better Auth core tables (managed by better-auth Prisma adapter)
model User {
  id              String           @id @default(cuid())
  email           String           @unique
  emailVerified   Boolean          @default(false)
  phone           String?
  passwordHash    String?
  suspended       Boolean          @default(false)
  name            String?
  role            Role             @default(student)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  sessions        Session[]
  accounts        Account[]
  studentProfile  StudentProfile?
  lecturerProfile LecturerProfile?
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
}

model Account {
  id                String @id @default(cuid())
  userId            String
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String
  providerAccountId String

  @@unique([provider, providerAccountId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
}

// Academic hierarchy — University → Faculty → Department → Level → Course.
// Every link is a real foreign key with Restrict deletes: no orphan faculties,
// departments, levels, or courses. Unique names per parent. Courses always sit
// under BOTH a department and one of that department's levels (enforced in API;
// see hierarchy.ts). Lecturers reach courses only via CourseLecturer.
model University {
  id        String           @id @default(cuid())
  name      String
  slug      String           @unique
  verified  Boolean          @default(false)
  suspended Boolean          @default(false)
  logoKey   String?
  faculties Faculty[]
  students  StudentProfile[]
}

model Faculty {
  id           String       @id @default(cuid())
  universityId String
  university   University   @relation(fields: [universityId], references: [id], onDelete: Restrict)
  name         String
  departments  Department[]
  students     StudentProfile[]

  @@unique([universityId, name])
}

model Department {
  id        String            @id @default(cuid())
  facultyId String
  faculty   Faculty           @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  name      String
  levels    Level[]
  courses   Course[]
  lecturers LecturerProfile[]
  students  StudentProfile[]

  @@unique([facultyId, name])
}

model Level {
  id           String     @id @default(cuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  name         String // 100, 200...
  courses      Course[]
  students     StudentProfile[]

  @@unique([departmentId, name])
}

model Course {
  id            String         @id @default(cuid())
  departmentId  String
  department    Department     @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  levelId       String
  level         Level          @relation(fields: [levelId], references: [id], onDelete: Restrict)
  code          String
  title         String
  isOfficial    Boolean        @default(false)
  lecturers     CourseLecturer[]
  enrollments   Enrollment[]
  purchases     Purchase[]
  orders        PaymentOrder[]
  materials     Material[]
  announcements Announcement[]
  questions     Question[]
  assessments   Assessment[]

  @@unique([departmentId, code])
}

// Lecturer ↔ course assignment: only assigned lecturers control course access
// (enrollment decisions, announcements, materials). Staff roles bypass.
model CourseLecturer {
  id         String          @id @default(cuid())
  courseId   String
  course     Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lecturerId String
  lecturer   LecturerProfile @relation(fields: [lecturerId], references: [id], onDelete: Cascade)
  role       String          @default("owner") // owner | co
  createdAt  DateTime        @default(now())

  @@unique([courseId, lecturerId])
}

model StudentProfile {
  id                 String              @id @default(cuid())
  userId             String              @unique
  user               User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  universityId       String
  university         University          @relation(fields: [universityId], references: [id], onDelete: Restrict)
  facultyId          String
  faculty            Faculty             @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  departmentId       String
  department         Department          @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  levelId            String
  level              Level               @relation(fields: [levelId], references: [id], onDelete: Restrict)
  matricNo           String
  verificationStatus VerificationStatus  @default(unverified)
  verifiedAt         DateTime?
  enrollments        Enrollment[]
  purchases          Purchase[]
  orders             PaymentOrder[]
  attempts           AssessmentAttempt[]
  gradeSemesters     GradeSemester[]
  verifications      VerificationRecord[]

  @@unique([universityId, matricNo])
}

model LecturerProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  departmentId       String
  department         Department         @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  staffId            String
  bio                String?
  verificationStatus VerificationStatus @default(unverified)
  verifiedAt         DateTime?
  materials          Material[]
  courses            CourseLecturer[]
  verifications      VerificationRecord[]

  @@unique([departmentId, staffId])
}

// Verification record — the state machine behind verificationStatus.
// pending → approved | rejected | needsCorrection | suspended.
// needsCorrection/rejected → pending (resubmit). suspended → pending (reinstate).
// Every transition writes a record + AuditLog + Notification (see verification.ts).
// Outcome uses its own enum: approving a request records "approved" while the
// profile itself becomes "verified" (verified ≠ enrolled — see enrollments.ts).
enum VerificationOutcome {
  pending
  approved
  rejected
  needsCorrection
  suspended
}

model VerificationRecord {
  id               String             @id @default(cuid())
  profileType      String             // student | lecturer
  studentProfileId String?
  studentProfile   StudentProfile?    @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  lecturerProfileId String?
  lecturerProfile  LecturerProfile?   @relation(fields: [lecturerProfileId], references: [id], onDelete: Cascade)
  status           VerificationOutcome @default(pending)
  note             String?
  decidedBy        String?
  decidedAt        DateTime?
  createdAt        DateTime           @default(now())

  @@index([status])
}

model Enrollment {
  id        String           @id @default(cuid())
  courseId  String
  course    Course           @relation(fields: [courseId], references: [id], onDelete: Restrict)
  studentId String
  student   StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Restrict)
  status    EnrollmentStatus @default(requested)
  createdAt DateTime         @default(now())

  @@unique([courseId, studentId])
}

model Material {
  id                 String            @id @default(cuid())
  courseId           String
  course             Course            @relation(fields: [courseId], references: [id], onDelete: Restrict)
  lecturerId         String
  lecturer           LecturerProfile   @relation(fields: [lecturerId], references: [id], onDelete: Restrict)
  title              String
  type               String
  description        String?
  priceKobo          Int               @default(0)
  isFree             Boolean        @default(true)
  accessDurationDays Int?
  version            Int            @default(0)
  pendingVersion     Int?
  status             MaterialStatus @default(draft)
  versions           MaterialVersion[]
  chunks             MaterialChunk[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

model MaterialVersion {
  id         String   @id @default(cuid())
  materialId String
  material   Material @relation(fields: [materialId], references: [id])
  version    Int
  fileKey    String // R2 materials/ key (original, private)
  checksum   String
  pageCount  Int      @default(0)
  createdAt  DateTime @default(now())
}

model Bundle {
  id         String       @id @default(cuid())
  lecturerId String
  title      String
  priceKobo  Int
  items      BundleItem[]
}

model BundleItem {
  id         String @id @default(cuid())
  bundleId   String
  bundle     Bundle @relation(fields: [bundleId], references: [id])
  materialId String
}

model Purchase {
  id              String         @id @default(cuid())
  studentId       String
  student         StudentProfile @relation(fields: [studentId], references: [id])
  materialId      String?
  bundleId        String?
  courseId        String?
  course          Course?        @relation(fields: [courseId], references: [id], onDelete: Restrict)
  versionGranted  Int?
  accessType      String         @default("purchase") // purchase | bundle | free
  orderId         String?        @unique
  order           PaymentOrder?  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  providerRef     String?
  amountKobo      Int
  pointsUsed      Int            @default(0)
  status          PurchaseStatus @default(pending)
  accessExpiresAt DateTime?
  createdAt       DateTime       @default(now())
}

model Announcement {
  id         String   @id @default(cuid())
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Restrict)
  lecturerId String
  category   String
  title      String
  body       String
  isUrgent   Boolean  @default(false)
  archived   Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Question {
  id        String         @id @default(cuid())
  courseId  String
  course    Course         @relation(fields: [courseId], references: [id], onDelete: Restrict)
  authorId  String
  title     String
  body      String
  status    QuestionStatus @default(unanswered)
  answers   Answer[]
  createdAt DateTime       @default(now())
}

model Answer {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id])
  authorId   String
  isLecturer Boolean  @default(false)
  body       String
  createdAt  DateTime @default(now())
}

model StudyEvent {
  id          String   @id @default(cuid())
  studentId   String
  courseId    String
  materialId  String?
  type        String
  page        Int?
  durationSec Int      @default(0)
  createdAt   DateTime @default(now())
}

// Payments (§13): provider-agnostic orders. Business logic NEVER touches a
// provider SDK directly — see src/payments/providers.ts. Sequence per order:
// pending → (initialize) → user pays at provider → webhook → signature check →
// server-to-server verify → paid exactly once → grant + earnings exactly once.
// `providerRef` is the provider's transaction reference (reconciliation key).
// `idempotencyKey` is client-supplied-or-generated (safe order retries).
enum PaymentOrderStatus {
  pending
  processing
  paid
  failed
  expired
  cancelled
}

model PaymentOrder {
  id             String             @id @default(cuid())
  studentId      String
  student        StudentProfile     @relation(fields: [studentId], references: [id], onDelete: Restrict)
  materialId     String?
  bundleId       String?
  courseId       String?
  course         Course?            @relation(fields: [courseId], references: [id], onDelete: Restrict)
  versionGranted Int?
  amountKobo     Int
  pointsUsed     Int                @default(0)
  status         PaymentOrderStatus @default(pending)
  provider       String             @default("mock")
  providerRef    String?            @unique
  idempotencyKey String             @unique
  providerData   Json?
  paidAt         DateTime?
  failureReason  String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  purchase       Purchase?
  webhooks       WebhookEvent[]
}

// Raw provider webhook events. `eventId` is the provider's unique event id
// (charge id / event token) — the idempotency key for replays. `raw` keeps the
// full payload for forensics/reconciliation (no card PANs ever arrive in these
// webhooks; card data stays at the provider).
model WebhookEvent {
  id              String        @id @default(cuid())
  provider        String
  eventId         String
  eventType       String
  orderId         String?
  order           PaymentOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  raw             Json
  signatureValid  Boolean       @default(false)
  processed       Boolean       @default(false)
  createdAt       DateTime      @default(now())

  @@unique([provider, eventId])
}

model ESpeesLedger {
  id                String           @id @default(cuid())
  lecturerId        String
  purchaseId        String           @unique
  grossKobo         Int
  lecturerShareKobo Int
  platformShareKobo Int
  status            LedgerStatus     @default(pending)
  settlementBatchId String?
  settlementBatch   SettlementBatch? @relation(fields: [settlementBatchId], references: [id])
  createdAt         DateTime         @default(now())
}

// Settlement period batch (§13.3): a run groups matured entries into a period;
// pay settles exactly one batch (idempotent by key). Ledger rows are
// append-only — amounts are never edited, only transitioned with batch links.
model SettlementBatch {
  id               String   @id @default(cuid())
  periodStart      DateTime
  periodEnd        DateTime
  status           String   @default("open") // open | paid | failed
  reference        String?
  totalGrossKobo   Int      @default(0)
  totalLecturerKobo Int     @default(0)
  totalPlatformKobo Int     @default(0)
  entryCount       Int      @default(0)
  idempotencyKey   String   @unique
  createdAt        DateTime @default(now())
  entries          ESpeesLedger[]
}

model PointLedger {
  id          String   @id @default(cuid())
  studentId   String
  amount      Int
  reason      String
  capKey      String?
  sourceRef   String?
  ruleVersion String   @default("v1")
  createdAt   DateTime @default(now())

  @@unique([studentId, capKey])
}

model Review {
  id         String       @id @default(cuid())
  materialId String
  studentId  String
  rating     Int
  body       String?
  status     String       @default("visible") // visible | hidden (moderated, never auto)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  replies    ReviewReply[]

  @@index([materialId, status])
}

model ReviewReply {
  id        String   @id @default(cuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  authorId  String
  isLecturer Boolean @default(false)
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Phase 2b — email outbox (dev: logged + console; prod: Resend/Postmark worker drains pending)
model EmailLog {
  id        String   @id @default(cuid())
  toUserId  String
  subject   String
  body      String
  status    String   @default("logged") // logged | sent | failed
  createdAt DateTime @default(now())
}

model Dispute {
  id           String   @id @default(cuid())
  reporterId   String
  targetType   String
  targetId     String
  reason       String
  evidence     String?
  status       String   @default("open") // open | under-review | resolved | dismissed | appealed | closed
  assignedTo   String?
  resolution   String?
  resolvedAt   DateTime?
  appealStatus String   @default("none") // none | pending | upheld | overturned
  appealReason String?
  slaDueAt     DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  actions      DisputeAction[]

  @@index([status])
  @@index([assignedTo])
}

// Actions-taken timeline: every state change, assignment, note and appeal
// decision lands here (in addition to AuditLog) so the queue can render a
// full history without joining the global audit table.
model DisputeAction {
  id        String   @id @default(cuid())
  disputeId String
  dispute   Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  actorId   String
  action    String
  note      String?
  createdAt DateTime @default(now())

  @@index([disputeId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())
}

model Devotional {
  id        String   @id @default(cuid())
  date      DateTime @unique
  title     String
  verse     String
  body      String
  sourceRef String?
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  targetType String
  targetId   String
  meta       String?
  createdAt  DateTime @default(now())
}

// Phase 2a — Assessments (§10.1): lecturer-built quizzes/tests/assignments.
// Objective (mcq) auto-graded; theory lecturer-graded. Attempts feed study journey + points eligibility.
model Assessment {
  id           String               @id @default(cuid())
  courseId     String
  course       Course               @relation(fields: [courseId], references: [id], onDelete: Restrict)
  title        String
  type         String               @default("quiz") // quiz | test | assignment
  instructions String?
  timeLimitMin Int?
  maxAttempts   Int                 @default(1)
  status        String              @default("draft") // draft | published | closed
  gradesReleased Boolean            @default(false)
  dueAt         DateTime?
  createdAt     DateTime            @default(now())
  questions     AssessmentQuestion[]
  attempts      AssessmentAttempt[]
}

model AssessmentQuestion {
  id           String             @id @default(cuid())
  assessmentId String
  assessment   Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  text         String
  kind         String             @default("mcq") // mcq | theory
  options      String[] // mcq options; empty for theory
  correctIndex Int? // mcq answer key (never sent to students)
  marks        Int                @default(1)
  order        Int                @default(0)
  answers      AssessmentAnswer[]
}

model AssessmentAttempt {
  id           String             @id @default(cuid())
  assessmentId String
  assessment   Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      StudentProfile     @relation(fields: [studentId], references: [id])
  attemptNo    Int                @default(1)
  status        String             @default("in-progress") // in-progress | submitted | graded
  score         Int?
  maxScore      Int?
  startedAt     DateTime           @default(now())
  submittedAt   DateTime?
  feedback      String?
  gradedBy      String?
  gradedAt      DateTime?
  answers       AssessmentAnswer[]

  @@unique([assessmentId, studentId, attemptNo])
}

model AssessmentAnswer {
  id            String             @id @default(cuid())
  attemptId     String
  attempt       AssessmentAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId    String
  question      AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedIndex Int?
  body          String?
  isCorrect     Boolean?
  marksAwarded  Int                @default(0)

  @@unique([attemptId, questionId])
}

// Phase 3 — RAG-lite: chunked authorized text per material version for
// entitlement-scoped full-text retrieval (pgvector upgrade path kept open;
// Postgres Pro build here lacks the vector extension).
model MaterialChunk {
  id         String   @id @default(cuid())
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  version    Int
  chunkNo    Int
  text       String
  createdAt  DateTime @default(now())

  @@unique([materialId, version, chunkNo])
}

// CGPA Calculator (5-point Nigerian scale: A=5 B=4 C=3 D=2 E=1 F=0).
// GPA = Σ(point × units)/Σunits per semester; CGPA across all semesters.
// Records feed the Study Journey; scale configurable per institution later.
model GradeSemester {
  id        String       @id @default(cuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  name      String       // e.g. "Year 2 · Semester 1"
  createdAt DateTime     @default(now())
  courses   GradeCourse[]
}

model GradeCourse {
  id         String        @id @default(cuid())
  semesterId String
  semester   GradeSemester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  code       String        // e.g. BIO 201
  title      String?
  units      Int
  grade      String        // A | B | C | D | E | F

  @@unique([semesterId, code])
}
