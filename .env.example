# EDUFARM local env template — copy to .env (per app) and fill on this device only. Never commit real keys.
# Postgres (local)
DATABASE_URL="postgresql://edufarm:change-me@localhost:5432/edufarm"
DATABASE_TEST_URL="postgresql://edufarm:change-me@localhost:5432/edufarm_test"

# Better Auth
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL_STUDENT="http://localhost:3001"
BETTER_AUTH_URL_LECTURER="http://localhost:3002"
BETTER_AUTH_URL_ADMIN="http://localhost:3003"

# API
API_PORT=4000
API_URL="http://localhost:4000"

# Cloudflare R2 (S3-compatible) — private buckets only
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_MATERIALS="edufarm-materials"
R2_BUCKET_PAGES="edufarm-pages"
R2_BUCKET_UPLOADS_TMP="edufarm-uploads-tmp"
R2_BUCKET_BACKUPS="edufarm-backups"
R2_PUBLIC_URL=""

# Payments (Naira)
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
PAYSTACK_WEBHOOK_SECRET=""
FLUTTERWAVE_SECRET_KEY=""

# Email
EMAIL_FROM="EDUFARM <noreply@edufarm.ng>"
RESEND_API_KEY=""
SMTP_HOST="localhost"
SMTP_PORT=1025

# AI worker
AI_WORKER_PORT=8001
LLM_API_KEY=""
LLM_MODEL=""

# App
NODE_ENV="development"
PLATFORM_FEE_BPS=3000
SETTLEMENT_HOLD_DAYS=7
